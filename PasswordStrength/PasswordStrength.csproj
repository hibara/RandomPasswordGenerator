<Project Sdk="Microsoft.NET.Sdk">

  <!--
    パスワード強度評価ライブラリ。
    UI（Avalonia）やアプリ固有の設定には依存せず、他の .NET アプリケーションへそのまま再利用できる。
    依存は .NET 標準ライブラリと Zxcvbn（Zxcvbn.NET）のみ。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PasswordStrength</RootNamespace>
    <AssemblyName>PasswordStrength</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>1.0.1</Version>
    <Authors>Mitsuhiro Hibara</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- zxcvbn-ts 4.x の .NET 移植。MIT ライセンス。バージョンは固定する -->
    <PackageReference Include="Zxcvbn" Version="0.1.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PasswordStrength.Tests" />
  </ItemGroup>

</Project>
