<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RandomPasswordGenerator</RootNamespace>
    <AssemblyName>RandomPasswordGenerator</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- app.manifest はテンプレート。ビルド時に GenerateAppManifest ターゲットが AssemblyVersion を埋めて obj/ に生成する -->
    <ApplicationManifest>$(BaseIntermediateOutputPath)app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 同じフォルダー配下にあるライブラリ／テストプロジェクトのソースを、このプロジェクトに含めない。
         先頭がアンダースコアのフォルダー（_tools, _installer など。ローカル専用で Git 管理外）も含めない -->
    <DefaultItemExcludes>$(DefaultItemExcludes);PasswordStrength/**;Tests/**;_*/**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    バージョンと製品情報の唯一の定義場所。
    Windows: exe のアセンブリ属性と Win32 バージョンリソースに埋め込まれる。
             _installer/update_build.bat は GetVer で <Version> を読み、Inno Setup は exe の FileVersion を使う。
    macOS:   publish 時に Assets/Info.plist のプレースホルダーへ展開されて .app バンドルに入る（BundleMacApp ターゲット）。
             _installer/build_and_release.sh は GetVer で <Version> を読み、DMG 名と release.yaml に使う。
  -->
  <PropertyGroup>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Product>Random Password Generator</Product>
    <Authors>Mitsuhiro Hibara</Authors>
    <Copyright>Copyright © Mitsuhiro Hibara</Copyright>
    <!-- macOS バンドル用 -->
    <MacBundleIdentifier>jp.hibara.RandomPasswordGenerator</MacBundleIdentifier>
    <!-- .NET 10 の対応 OS は macOS 14 以降 -->
    <MacMinimumSystemVersion>14.0</MacMinimumSystemVersion>
    <!-- 署名 ID。"-" はアドホック署名（ローカル実行用）。配布時は build_and_release.sh が空にして無効化し、Developer ID で署名し直す -->
    <MacCodesignIdentity>-</MacCodesignIdentity>
  </PropertyGroup>

  <ItemGroup>
    <!-- Info.plist は .app バンドル用のテンプレートなので、アプリのリソースには含めない -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Info.plist" />
    <!-- 覚えやすいパスワード用の日本語ローマ字辞書（5,872 語）。実行ファイルに埋め込む -->
    <EmbeddedResource Include="dic\japanese_passphrase_romaji.txt" LogicalName="RandomPasswordGenerator.dic.japanese_passphrase_romaji.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="PasswordStrength\PasswordStrength.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RandomPasswordGenerator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ShadUI" Version="0.2.4" />
  </ItemGroup>

  <!--
    Windows 用 app.manifest をテンプレート（プロジェクト直下の app.manifest）から生成する。
    assemblyIdentity の version に csproj の AssemblyVersion を埋め込み、版数の定義を csproj に一本化する。
    出力先は obj/app.manifest（ApplicationManifest プロパティが指す先）。
  -->
  <Target Name="GenerateAppManifest" BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectDirectory)/app.manifest;$(MSBuildProjectFullPath)"
          Outputs="$(ApplicationManifest)">
    <PropertyGroup>
      <_AppManifestText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/app.manifest').Replace('__ASSEMBLY_VERSION__', '$(AssemblyVersion)'))</_AppManifestText>
    </PropertyGroup>
    <Error Condition="$(_AppManifestText.Contains('__ASSEMBLY_VERSION__'))" Text="app.manifest の __ASSEMBLY_VERSION__ を置換できませんでした（AssemblyVersion が空？）" />
    <WriteLinesToFile File="$(ApplicationManifest)" Lines="$(_AppManifestText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Message Importance="normal" Text="app.manifest を生成: $(ApplicationManifest) (version=$(AssemblyVersion))" />
  </Target>

  <!--
    macOS 向け publish 後に .app バンドルを組み立てる。
      dotnet publish -c Release -r osx-arm64
    → bin/Release/net10.0/osx-arm64/publish/RandomPasswordGenerator.app
    Info.plist は Assets/Info.plist のプレースホルダーを上の PropertyGroup の値で置き換えて生成する。
  -->
  <Target Name="BundleMacApp" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <PropertyGroup>
      <_AppDir>$(PublishDir)$(AssemblyName).app/</_AppDir>
      <_ContentsDir>$(_AppDir)Contents/</_ContentsDir>
      <_MacOSDir>$(_ContentsDir)MacOS/</_MacOSDir>
      <_ResourcesDir>$(_ContentsDir)Resources/</_ResourcesDir>
      <_PlistText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Assets/Info.plist')
        .Replace('__NAME__', '$(AssemblyName)')
        .Replace('__DISPLAY_NAME__', '$(Product)')
        .Replace('__IDENTIFIER__', '$(MacBundleIdentifier)')
        .Replace('__VERSION__', '$(Version)')
        .Replace('__COPYRIGHT__', '$(Copyright)')
        .Replace('__MIN_OS__', '$(MacMinimumSystemVersion)'))</_PlistText>
    </PropertyGroup>
    <ItemGroup>
      <_PublishedFiles Include="$(PublishDir)**/*" Exclude="$(_AppDir)**" />
    </ItemGroup>

    <RemoveDir Directories="$(_AppDir)" />
    <MakeDir Directories="$(_MacOSDir);$(_ResourcesDir)" />
    <Copy SourceFiles="@(_PublishedFiles)" DestinationFiles="@(_PublishedFiles->'$(_MacOSDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <!-- Info.plist の CFBundleIconFile = "icon" に合わせて icon.icns という名前で置く -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Assets/icon.icns" DestinationFiles="$(_ResourcesDir)icon.icns" />
    <WriteLinesToFile File="$(_ContentsDir)Info.plist" Lines="$(_PlistText)" Overwrite="true" />
    <WriteLinesToFile File="$(_ContentsDir)PkgInfo" Lines="APPL????" Overwrite="true" />
    <Exec Command="chmod +x &quot;$(_MacOSDir)$(AssemblyName)&quot;" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <!-- Apple Silicon では未署名バイナリが起動できないため、最低でもアドホック署名しておく（macOS 上でのみ実行） -->
    <Exec Command="codesign --force --deep --sign &quot;$(MacCodesignIdentity)&quot; &quot;$(_AppDir)&quot;" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(MacCodesignIdentity)' != ''" />
    <Message Importance="high" Text="macOS bundle: $(_AppDir)" />
  </Target>

</Project>
