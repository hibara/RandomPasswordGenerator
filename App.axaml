<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             x:Class="RandomPasswordGenerator.App"
             Name="Random Password Generator"
             RequestedThemeVariant="Default">
    <!-- RequestedThemeVariant="Default" で OS のライト／ダーク設定に追従する -->

    <Application.Resources>
        <!-- パスワード表示用の等幅フォント。Courier Prime Bold の改変版（0 にスラッシュ等）。OFL の予約フォント名の規定により内部名を RPG Mono に変更している -->
        <FontFamily x:Key="PasswordFont">avares://RandomPasswordGenerator/Assets/Fonts#RPG Mono</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <shadui:ShadTheme />
    </Application.Styles>
</Application>
